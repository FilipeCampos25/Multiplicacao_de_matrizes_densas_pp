# Normalize text in the repository and keep files consumed by Linux tools in LF.
* text=auto

*.sh        text eol=lf
*.py        text eol=lf
*.md        text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Keep notebook JSON stable; never convert actual binary artifacts.
*.ipynb     text eol=lf
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
